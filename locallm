#!/bin/sh
set -eu
case "${1:-}" in
  start|destroy) ;;
  *) echo 'Usage: ./locallm start [project] [OpenCode flags...] | ./locallm destroy' >&2; exit 2 ;;
esac
repo=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v uv >/dev/null 2>&1; then
  if [ -x "$HOME/.local/bin/uv" ]; then
    PATH="$HOME/.local/bin:$PATH"
    export PATH
  else
    installer=$(mktemp)
    trap 'rm -f "$installer"' EXIT HUP INT TERM
    curl -fsSL https://astral.sh/uv/install.sh -o "$installer"
    UV_NO_MODIFY_PATH=1 UV_INSTALL_DIR="$HOME/.local/bin" sh "$installer"
    rm -f "$installer"
    trap - EXIT HUP INT TERM
    PATH="$HOME/.local/bin:$PATH"
    export PATH
  fi
fi
exec uv run --no-project --no-config --python 3.12 "$repo/setup.py" "$@"
