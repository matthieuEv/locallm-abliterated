{
  "$schema": "https://opencode.ai/config.json",
  "model": "rapid-mlx/Youssofal/Qwen3.6-35B-A3B-Abliterated-Heretic-MLX-4bit",
  "update": "disable",
  "plugins": ["*", "-local.rapid-compaction"],
  "providers": {
    "rapid-mlx": {
      "name": "Rapid-MLX",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "local",
        "headerTimeout": 600000
      },
      "models": {
        "Youssofal/Qwen3.6-35B-A3B-Abliterated-Heretic-MLX-4bit": {
          "name": "Youssofal/Qwen3.6-35B-A3B-Abliterated-Heretic-MLX-4bit",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": 49152, "input": 40960, "output": 8192 },
          "body": { "chat_template_kwargs": { "enable_thinking": false } }
        }
      }
    }
  },
  "compaction": { "auto": true, "keep": { "tokens": 4000 }, "buffer": 4096 },
  "tool_output": { "max_lines": 200, "max_bytes": 12000 },
  "instructions": ["{env:HOME}/.config/opencode/local-context.md"]
}
